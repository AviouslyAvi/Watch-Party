{
  "manifest_version": 3,
  "name": "Watch-Party",
  "version": "0.8.10",
  "description": "Teleparty-style synchronized watch party for any site with a video player. Auto-activates on invite links; click the toolbar icon to start a party manually.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Watch-Party (off — click to turn on)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
